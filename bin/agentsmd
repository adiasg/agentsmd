#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

resolve_path() {
  local target="$1"
  if command -v realpath > /dev/null 2>&1; then
    realpath "$target"
  else
    python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$target" 2> /dev/null || perl -MCwd -e 'print Cwd::abs_path($ARGV[0])' "$target"
  fi
}

script_path=$(resolve_path "${BASH_SOURCE[0]}")
BIN_DIR=$(cd "$(dirname "$script_path")" && pwd)
PROJECT_ROOT=$(resolve_path "$BIN_DIR/..")
export AGENTSMD_ROOT="$PROJECT_ROOT"
export AGENTSMD_LIB_DIR="$AGENTSMD_ROOT/lib/agentsmd"
export AGENTSMD_SHARE_DIR="$AGENTSMD_ROOT/share/agentsmd"

# shellcheck source=lib/agentsmd/core.sh
. "$AGENTSMD_LIB_DIR/core.sh"

agentsmd_main "$@"
